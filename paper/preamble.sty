% inline code: \texttt on a light grey ground with rounded corners, like the
% appendix prompt boxes. The text is set as a row of boxes, split at spaces and
% after underscores; only the row's two ends are rounded. A line may break
% between the boxes: at a space, where grey glue joins them and is dropped at
% the break, or after an underscore, so long identifiers need not overrun
\colorlet{codeground}{black!6}
\tcbset{code/.style={on line, colback=codeground, colupper=black, frame hidden,
	boxrule=0pt, arc=1.5pt, boxsep=0pt, left=1.5pt, right=1.5pt, top=1pt, bottom=1pt,
	before upper=\vphantom{Ag}}}
\newcommand*{\code@boxonly}{\tcbox[code]}
\newcommand*{\code@boxfirst}{\tcbox[code, right=0pt, sharp corners=east]}
\newcommand*{\code@boxmid}{\tcbox[code, left=0pt, right=0pt, sharp corners]}
\newcommand*{\code@boxlast}{\tcbox[code, left=0pt, sharp corners=west]}
\newif\ifcode@first
\newif\ifcode@last
\newcommand*{\code@box}[1]{%
	\ifcode@first
		\ifcode@last\code@boxonly{#1}\else\code@boxfirst{#1}\fi
	\else
		\ifcode@last\code@boxlast{#1}\else\code@boxmid{#1}\fi
	\fi
	\code@firstfalse}
\newcommand*{\code@glue}{{\setbox\z@\hbox{Ag}\color{codeground}%
	\leaders\vrule height\dimexpr\ht\z@+1pt\relax depth\dimexpr\dp\z@+1pt\relax
	\hskip\fontdimen2\font\relax}}
\DeclareRobustCommand{\texttt}[1]{{\ttfamily\code@firsttrue\code@words#1 \code@end}}
% one word per call: its pieces, then glue and the next word
\def\code@words#1 #2\code@end{%
	\def\code@restwords{#2}%
	\code@pieces#1\_\code@end
	\ifx\code@restwords\@empty\else
		\code@glue\expandafter\code@words\code@restwords\code@end
	\fi}
% one piece per call: the text up to and including an underscore
\def\code@pieces#1\_#2\code@end{%
	\def\code@restpieces{#2}%
	\ifx\code@restpieces\@empty
		\ifx\code@restwords\@empty\code@lasttrue\fi
		\code@box{#1}%
	\else
		\code@box{#1\_}\allowbreak\expandafter\code@pieces\code@restpieces\code@end
	\fi}
% the same box for verbatim code, \codeverb|...|, which cannot break
\NewDocumentCommand{\codeverb}{v}{{\ttfamily\code@boxonly{#1}}}

