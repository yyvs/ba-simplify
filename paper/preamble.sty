% grey for the toc divider rules and the front/back matter entries
\colorlet{tocgrey}{black!55}

% \tocgreyon / \tocgreyoff: written into a .toc or .lot stream to set the entries
% in between in grey, with chapter-level entries styled as section entries
% (indented, not bold, dotted leaders); the .lot has no chapter entries.
% \default@color is redefined because KOMA resets entries and page numbers to it.
% \toc@keepskip moves the colour whatsit behind the preceding glue, so a following
% \addvspace can still merge with that glue instead of adding to it.
\newcommand*{\toc@keepskip}[1]{%
	\ifvmode
		\ifdim\lastskip=\z@
			#1%
		\else
			\edef\toc@restoreskip{\vskip\the\lastskip\relax}%
			\vskip-\lastskip
			#1%
			\toc@restoreskip
		\fi
	\else
		#1%
	\fi}
\AtBeginDocument{\let\toc@blackcolor\default@color}
\newcommand*{\toc@styleattrs}{indent,beforeskip,entryformat,pagenumberformat,linefill}
\newcommand*{\tocgreyon}{%
	\toc@keepskip{\color{tocgrey}}%
	\edef\default@color{\current@color}%
	\@for\toc@attr:=\toc@styleattrs\do{%
		\expandafter\let\csname toc@saved@\toc@attr\expandafter\endcsname
		\csname scr@tso@chapter@\toc@attr\endcsname
		\expandafter\let\csname scr@tso@chapter@\toc@attr\expandafter\endcsname
		\csname scr@tso@section@\toc@attr\endcsname}%
}
\newcommand*{\tocgreyoff}{%
	\let\default@color\toc@blackcolor
	\toc@keepskip{\normalcolor}%
	\@for\toc@attr:=\toc@styleattrs\do{%
		\expandafter\let\csname scr@tso@chapter@\toc@attr\expandafter\endcsname
		\csname toc@saved@\toc@attr\endcsname}%
}

% \tocdivider: a centred rule written into a .toc or .lot stream to separate the
% thesis proper from the front or back matter. Set as a box, not a paragraph, so
% \tocdividerskip is the visible gap; nothing may be written between the rule and
% the next entry, or its \addvspace stacks instead of merging. A page break is
% allowed before the rule; \@nobreak keeps it attached to the entry after it.
\newcommand*{\tocdividerwidth}{.9\linewidth}
\newcommand*{\tocdividerskip}{1em}
\newcommand*{\tocdivider}{%
	\par
	\addvspace{\tocdividerskip}%
	\penalty-\@highpenalty
	\nointerlineskip
	\hb@xt@\linewidth{%
		\hss\textcolor{tocgrey}{\rule{\tocdividerwidth}{.4pt}}\hss}%
	\nointerlineskip
	\addvspace{\tocdividerskip}%
	\global\@nobreaktrue
	\everypar{\global\@nobreakfalse\everypar{}}%
}

