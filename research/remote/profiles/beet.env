# Host profile for the cl-hhu GPU boxes. Source it from research/ every new shell:
#
#     source remote/profiles/beet.env
#
# Named after beet (isi-8.phil.hhu.de, RTX A5000 24 GB) but valid for any cl-hhu machine
# (aker, carrot, shai, turnip): plain SSH hosts, no scheduler; train.py detects VRAM itself.
#
# NO CREDENTIALS in this file or anywhere in the repo. Use SSH keys (`ssh-copy-id`).

# where we are
export HHU_PROFILE="beet"
# evaluate_*.py resolve scratch/ and results/ relative to research/
export HHU_RESEARCH_DIR="${HHU_RESEARCH_DIR:-$PWD}"

# HuggingFace cache off $HOME (BART checkpoints, roberta-large, LENS vs. a small home quota)
export HF_HOME="$HHU_RESEARCH_DIR/scratch/hf"
export HF_HUB_ENABLE_HF_TRANSFER=0
mkdir -p "$HF_HOME"

# Ollama, for the prompted-LLM conditions (7B q4_K_M ~4.7 GB, 3B ~1.9 GB: off $HOME too)
export OLLAMA_MODELS="$HHU_RESEARCH_DIR/scratch/ollama"
export OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
# keep_alive -1 keeps a model resident. Must be sent as a JSON *number*: a string is parsed
# as a Go duration and returns HTTP 400 "missing unit in duration" (the §4.9 bug).
export OLLAMA_KEEP_ALIVE=-1
mkdir -p "$OLLAMA_MODELS"

# thread limits: shared machines, no scheduler. Unbounded torch/OpenMP threads starve other
# users (§6.4 measured the sentence path degrading 7.8x between load ~4 and ~6.4).
CORES="$(nproc 2>/dev/null || echo 8)"
export OMP_NUM_THREADS="$(( CORES / 2 > 0 ? CORES / 2 : 1 ))"
export MKL_NUM_THREADS="$OMP_NUM_THREADS"
export TOKENIZERS_PARALLELISM=false

# torch: train.py enables bf16/TF32 on Ampere. expandable_segments cuts fragmentation on
# long fixed-shape runs.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# pin to one GPU on multi-GPU hosts
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

# userspace binaries: a rootless Ollama lands in ~/.local/bin, which nothing here puts on
# PATH. `ollama pull`/`stop` need the binary; the evaluations only need the server.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) [ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH" ;;
esac

# venv
if [ -d "$HHU_RESEARCH_DIR/venv-gpu" ]; then
  # shellcheck disable=SC1091
  . "$HHU_RESEARCH_DIR/venv-gpu/bin/activate"
fi

echo "profile: beet"
echo "  HF_HOME        $HF_HOME"
echo "  OLLAMA_MODELS  $OLLAMA_MODELS"
echo "  threads        OMP=$OMP_NUM_THREADS of $CORES cores"
echo "  python         $(command -v python)"
echo
echo "Reserve the GPU before running anything long:"
echo "  https://calendar.online/5afa284259e0c92ff6a2"
echo "Then: python remote/gpucheck.py && python remote/preflight.py"
