# Host profile for the HHU HPC cluster (hpc.rz.uni-duesseldorf.de): PBSPro instead of a
# calendar, a parallel filesystem, a module system, and no internet on compute nodes.
#
#     source remote/profiles/hpc.env
#
# Only the storage node reaches the internet (hpc-tutorial: `storage.hpc.rz...` "allows
# connections for loading huggingface models"; `hpc.rz...` is for login and qsub). Prefetch
# with remote/hpc/prefetch.sh; HF_HUB_OFFLINE=1 here.

export HHU_PROFILE="hpc"

# Kennung: your HHU username. Set it in your shell, don't commit it:
#   export HHU_KENNUNG=yourname
: "${HHU_KENNUNG:?set HHU_KENNUNG to your HHU username before sourcing this profile}"
# PBS account for `qsub -A` (tutorial example: `iss`; ask whoever gave you access).
export HHU_PBS_ACCOUNT="${HHU_PBS_ACCOUNT:-}"

# filesystems (HPC wiki, via the tutorial):
#   ~                          50 GB soft quota. "Don't work here."
#   /gpfs/project/<Kennung>    several TB, backed up -- project data.
#   /gpfs/scratch/<Kennung>    larger, NOT backed up, and files older than 60 days are
#                              DELETED AUTOMATICALLY. Faster for heavy I/O (the wiki
#                              measured ~5x on a ~1 GB file).
#
# Checkpoints and caches on scratch; results and the repo on project. A checkpoint left
# only on scratch vanishes after 60 days.
export HHU_PROJECT="/gpfs/project/$HHU_KENNUNG"
export HHU_SCRATCH="/gpfs/scratch/$HHU_KENNUNG"
export HHU_RESEARCH_DIR="${HHU_RESEARCH_DIR:-$HHU_PROJECT/ba-simplify/research}"

# HuggingFace
export HF_HOME="$HHU_SCRATCH/.cache/huggingface"
mkdir -p "$HF_HOME"
# offline: a missing file fails immediately instead of retrying until walltime
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="$HF_HUB_OFFLINE"
export HF_DATASETS_OFFLINE="$HF_HUB_OFFLINE"

export OLLAMA_MODELS="$HHU_SCRATCH/ollama"

# modules and pip
# The cluster reaches PyPI only through its own mirror.
export PIP_CONFIG_FILE=/software/python/pip.conf
if command -v module >/dev/null 2>&1; then
  module load Python/3.10.12 2>/dev/null || echo "  (module load Python failed -- wrong node?)"
  module load hpc-tools 2>/dev/null || true
fi

export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

if [ -d "$HHU_RESEARCH_DIR/venv-gpu" ]; then
  # shellcheck disable=SC1091
  . "$HHU_RESEARCH_DIR/venv-gpu/bin/activate"
fi

cat <<EOF
profile: hpc
  Kennung        $HHU_KENNUNG
  project        $HHU_PROJECT      (backed up; results live here)
  scratch        $HHU_SCRATCH      (NOT backed up; 60-day auto-delete)
  HF_HOME        $HF_HOME
  offline mode   HF_HUB_OFFLINE=$HF_HUB_OFFLINE

Workflow here is different from the cl-hhu boxes:

  1. On the STORAGE node (the only one with internet), prefetch models and corpora:
       ssh $HHU_KENNUNG@storage.hpc.rz.uni-duesseldorf.de
       cd $HHU_RESEARCH_DIR && bash remote/hpc/prefetch.sh

  2. On the LOGIN node, check what is free and submit:
       module load hpc-tools && gpus_available
       qsub remote/hpc/train_document_full.pbs
       qstat -u $HHU_KENNUNG

  3. Or take an interactive session for short work:
       qsub -I -l select=1:ncpus=8:mem=64GB:ngpus=1:accelerator_model=a100 \\
            -l walltime=04:00:00 ${HHU_PBS_ACCOUNT:+-A $HHU_PBS_ACCOUNT}

Job resource usage afterwards: https://myjam3.uni-duesseldorf.de/
EOF
